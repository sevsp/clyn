# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pagopar — sandbox tokens while there's no merchant account yet.
# Docs / test tokens: https://www.pagopar.com/docs
PAGOPAR_ENV=sandbox
PAGOPAR_PUBLIC_TOKEN=
PAGOPAR_PRIVATE_TOKEN=

# Used to build absolute return/cancel/notify URLs for Pagopar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
